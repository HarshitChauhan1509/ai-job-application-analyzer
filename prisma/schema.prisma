generator client {
  provider = "prisma-client-js"
}

datasource db {
  // provider = "sqlite"
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile           Profile?
  resumes           Resume[]
  jobs              Job[]
  applications      Application[]
  interviewSessions InterviewSession[]
  aiConversations   AIConversation[]
  notifications     Notification[]
  subscription      Subscription?
  paymentOrders     PaymentOrder[]
  credit            UserCredit?
}

model Profile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  username   String?  @unique
  isPublic   Boolean  @default(true)
  headline   String?
  bio        String?
  website    String?
  linkedin   String?
  github         String?
  githubProjects String?  // Stored as JSON string array of GitHub project showcase objects
  experience     String?  // Stored as JSON string array of Experience objects
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Resume {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  fileUrl       String
  isPrimary     Boolean  @default(false)
  targetRole    String?
  resumeType    String?  @default("GENERAL")
  targetCompany String?
  targetJobId   String?
  tags          String?  // Stored as JSON string array
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  analysis     ResumeAnalysis?
  applications Application[]
  jobMatches   JobMatch[]
}

model ResumeAnalysis {
  id              String   @id @default(cuid())
  resumeId        String   @unique
  resume          Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  overallScore    Int
  atsScore        Int
  skillsScore     Int
  experienceScore Int
  strengths       String // Stored as JSON string array
  weaknesses      String // Stored as JSON string array
  missingKeywords String // Stored as JSON string array
  recommendations String // Stored as JSON string array
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Job {
  id                    String   @id @default(cuid())
  userId                String?
  user                  User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company               String
  position              String
  description           String
  url                   String?
  location              String?
  employmentType        String?
  experienceRequirement String?
  isCurated             Boolean  @default(false)
  startupStage          String?  // Seed, Series A, Series B, Growth, Public
  salaryRange           String?  // e.g. "$140k - $185k • 0.1% - 0.25%"
  department            String?  // Frontend, Backend, Fullstack, AI / ML, DevOps
  logoUrl               String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  analysis     JobAnalysis?
  applications Application[]
  jobMatches   JobMatch[]
}

model JobAnalysis {
  id               String   @id @default(cuid())
  jobId            String   @unique
  job              Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  requiredSkills   String // JSON string array
  preferredSkills  String // JSON string array
  responsibilities String // JSON string array
  keywords         String // JSON string array
  seniority        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Application {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Restrict)
  resumeId  String?
  resume    Resume?  @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  status    String   @default("SAVED") // SAVED, APPLIED, SCREENING, INTERVIEW, OFFER, REJECTED
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events ApplicationEvent[]
}

model ApplicationEvent {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String // e.g., STATUS_CHANGE, NOTE_ADDED, EMAIL_RECEIVED
  description   String?
  date          DateTime    @default(now())
  createdAt     DateTime    @default(now())
}

model JobMatch {
  id              String   @id @default(cuid())
  resumeId        String
  resume          Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobId           String
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  overallScore    Int
  skillsScore     Int
  experienceScore Int
  keywordsScore   Int
  strongMatches   String // JSON string array
  missingSkills   String // JSON string array
  missingKeywords String // JSON string array
  recommendations String // JSON string array
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([resumeId, jobId])
}

model InterviewSession {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         String
  difficulty   String
  overallScore Float?
  feedback     String?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  questions InterviewQuestion[]
}

model InterviewQuestion {
  id                 String           @id @default(cuid())
  interviewSessionId String
  interviewSession   InterviewSession @relation(fields: [interviewSessionId], references: [id], onDelete: Cascade)
  question           String
  category           String
  orderIndex         Int
  createdAt          DateTime         @default(now())

  answer InterviewAnswer?
}

model InterviewAnswer {
  id                  String            @id @default(cuid())
  interviewQuestionId String            @unique
  interviewQuestion   InterviewQuestion @relation(fields: [interviewQuestionId], references: [id], onDelete: Cascade)
  answer              String
  score               Float?
  feedback            String?
  createdAt           DateTime          @default(now())
}

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  context   String?
  messages  String // Store JSON as string instead of Json type for SQLite compatibility
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model Subscription {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               String    @default("FREE") // FREE, PRO, LIFETIME
  status             String    @default("ACTIVE") // ACTIVE, TRIALING, PAST_DUE, CANCELED, UNPAID
  provider           String    @default("STRIPE") // STRIPE, DODO, RAZORPAY, LEMON_SQUEEZY
  customerId         String?   // Provider customer identifier
  subscriptionId     String?   @unique // Provider subscription identifier
  priceId            String?   // Provider plan/price identifier
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
  @@index([customerId])
  @@index([subscriptionId])
}

model PaymentOrder {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   String   @default("STRIPE")
  orderId    String   @unique // Provider checkout session or order identifier
  paymentId  String?  // Provider payment intent or charge identifier
  amount     Int      // Amount in smallest unit (e.g., cents or paise)
  currency   String   @default("USD")
  plan       String   // PRO, LIFETIME
  status     String   @default("PENDING") // PENDING, COMPLETED, FAILED, REFUNDED
  receiptUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([orderId])
}

model UserCredit {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance     Int      @default(50) // Free tier initial allocation
  totalEarned Int      @default(50)
  totalSpent  Int      @default(0)
  updatedAt   DateTime @updatedAt

  transactions CreditLedger[]
}

model CreditLedger {
  id           String     @id @default(cuid())
  userCreditId String
  userCredit   UserCredit @relation(fields: [userCreditId], references: [id], onDelete: Cascade)
  amount       Int        // Positive for credit add, negative for deduction
  balanceAfter Int
  action       String     // OUTREACH_PITCH, RESUME_ANALYSIS, EMAIL_PARSER, MONTHLY_REFRESH, PLAN_PURCHASE
  description  String?
  createdAt    DateTime   @default(now())

  @@index([userCreditId])
}
